# Copy this file to .env and export the values, or set them in your process
# manager / systemd unit.  Nothing here is read automatically: the application
# only looks at real environment variables.

# Optional: the app generates and persists a random key in .secret_key when this
# is unset, so a bare `python app.py` works out of the box.  Set it explicitly
# for multi-instance deployments so every instance shares the same key.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SPEAK_SECRET_KEY=
# SPEAK_SECRET_KEY_FILE=.secret_key

# Development switches
SPEAK_DEBUG=false
SPEAK_HOST=127.0.0.1
SPEAK_PORT=5002

# Database file (defaults to <project>/database.db)
# SPEAK_DATABASE=/var/lib/speak/database.db

# Cookies: enable SPEAK_COOKIE_SECURE when the site is served over HTTPS
# SPEAK_COOKIE_SECURE=true
# SPEAK_SESSION_HOURS=12

# Socket.IO: threading (default, long-polling) | gevent | eventlet
# SPEAK_SOCKETIO_ASYNC_MODE=threading
# SPEAK_SOCKETIO_PATH=socket.io
# Comma separated origins; leave empty to enforce the same-origin policy.
# SPEAK_SOCKETIO_CORS_ALLOWED_ORIGINS=https://chat.example.com

# Initial administrator
SPEAK_ADMIN_USERNAME=root
# Leave empty in production to get a random password logged once at startup.
SPEAK_ADMIN_PASSWORD=

# Chat limits
SPEAK_CHAT_MAX_MESSAGE_LENGTH=500
SPEAK_CHAT_HISTORY_SIZE=50
SPEAK_CHAT_MESSAGES_PER_WINDOW=20
SPEAK_CHAT_RATE_WINDOW_SECONDS=10

# Authentication hardening
SPEAK_LOGIN_MAX_ATTEMPTS=5
SPEAK_LOGIN_WINDOW_SECONDS=300

# Cloudflare Turnstile (人机验证) — optional bot protection for login/register.
# Get both keys from https://dash.cloudflare.com/ -> Turnstile -> Add site.
# Leave empty to disable; the forms then work without any challenge.
# SPEAK_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# SPEAK_TURNSTILE_SECRET_KEY=0x4AAAAAAA...
# SPEAK_TURNSTILE_TIMEOUT=5

# Response hardening
SPEAK_SECURITY_HEADERS=true
